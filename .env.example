# This root file documents testnet deployment variables. Never copy a filled
# private key into apps/web/.env.local; use the Hardhat keystore instead.
# Public RPC endpoints may be changed for local development.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io

# Set only after manual deployment to OP Sepolia.
NEXT_PUBLIC_MOCK_USD_ADDRESS=
NEXT_PUBLIC_PAYMENT_REGISTRY_ADDRESS=

# Used only by the explicit testnet mint script after manual deployment.
MOCK_USD_ADDRESS=

# Demo deployer secrets are local-only and must never be committed.
# Prefer: pnpm --filter @payment-demo/contracts exec hardhat keystore set OP_SEPOLIA_PRIVATE_KEY
OP_SEPOLIA_PRIVATE_KEY=
